PROJECT_NAME=dientu

POSTGRES_IMAGE=dientu_postgres:dev
POSTGRES_DB=dientu
POSTGRES_USER=dientu
POSTGRES_PASSWORD=123
POSTGRES_HOST_PORT=1000
POSTGRES_CONTAINER_PORT=1000
POSTGRES_DATA_VOLUME=../postgres/data/dev

SERVER_IMAGE=dientu_server:dev
SERVER_HOST_PORT=3000
SERVER_CONTAINER_PORT=3000
SERVER_HOST=0.0.0.0
SERVER_SOURCE_VOLUME=../server

CLIENT_IMAGE=dientu_client:dev
CLIENT_HOST_PORT=5000
CLIENT_CONTAINER_PORT=5000
CLIENT_HOST=0.0.0.0
CLIENT_SOURCE_VOLUME=../client

DOCKER_NETWORK=dientu_network
